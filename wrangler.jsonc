// Cloudflare Worker: javne stranice su statične datoteke iz dist/,
// a mali poslužiteljski dio (dist/_worker.js) služi samo admin (/keystatic).
// Ovu datoteku ne brisati: bez nje Cloudflare pri svakoj objavi sam
// prepravlja projekt.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokrecem-posao",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  // Ključevi za admin postavljaju se u Cloudflareu (Settings → Variables and Secrets)
  // i objava ih ne smije obrisati.
  "keep_vars": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    // Admin i njegov API uvijek idu u Worker, ne u statične datoteke.
    // Nepostojeće adrese također idu u Worker, koji vraća našu 404 stranicu.
    "run_worker_first": ["/keystatic", "/keystatic/*", "/api/keystatic/*", "/api/admin-status", "/pregled", "/pregled/"]
  },
  "observability": {
    "enabled": true
  }
}
