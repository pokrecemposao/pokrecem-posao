// Cloudflare: stranica se objavljuje kao statične datoteke iz dist/.
// Postojanje ove datoteke sprječava da Cloudflare pri svakoj objavi sam
// prepravlja projekt (dodaje adapter, poslužiteljski način i sesije).
// Poslužiteljski dio dodajemo namjerno tek u fazi 1, za Keystatic admin.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pokrecem-posao",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
