---
import Logo from "./Logo.astro";
import { FOOTER_LINKS, SITE, SOCIAL } from "../config/site.ts";

const year = new Date().getFullYear();
---
<footer class="wrap mt-12">
  <section
    id="prati"
    class="grid items-center gap-6 rounded-[20px] bg-ink p-[22px] text-cream desk:grid-cols-[auto_1fr] desk:p-7 min-[1020px]:grid-cols-[auto_1fr_auto]"
    aria-label="Društvene mreže"
  >
    <Logo class="hidden h-[72px] w-auto text-cream desk:block" />
    <p class="m-0 font-display text-[22px] font-bold leading-tight desk:border-l-[1.5px] desk:border-[#5a554b] desk:pl-6 desk:text-[26px]">
      Prati projekt i na društvenim mrežama.
    </p>
    <ul class="m-0 grid list-none grid-cols-2 gap-x-7 gap-y-3 p-0 text-sm text-[#cfc7b7] desk:col-span-full desk:flex desk:flex-wrap min-[1020px]:col-span-1">
      {
        SOCIAL.map((s) => (
          <li>
            <b class="block text-base text-cream">{s.label}</b>
            {s.handle}
          </li>
        ))
      }
    </ul>
  </section>
  <div class="flex flex-wrap justify-between gap-3 pt-[22px] pb-[30px] text-sm text-muted">
    <span>© {year} {SITE.title.charAt(0) + SITE.title.slice(1).toLowerCase()}</span>
    <nav class="flex gap-[18px]" aria-label="Podnožje">
      {FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</footer>
