---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { NAV, SITE } from "../config/site.ts";

interface Props {
  current: string;
}
const { current } = Astro.props;
---
<header class="sticky top-0 z-20 border-b border-line bg-cream/95 backdrop-blur">
  <div class="wrap flex h-[68px] items-center gap-4 desk:h-[76px] desk:gap-6">
    <a href="/" class="flex min-w-0 items-center gap-3 no-underline" aria-label={`${SITE.title}, početna`}>
      <Logo class="h-11 w-auto shrink-0 text-mark desk:h-[50px]" />
      <span class="flex min-w-0 flex-col gap-0.5 min-[1360px]:flex-row min-[1360px]:items-center min-[1360px]:gap-4">
        <span class="font-wordmark whitespace-nowrap text-[25px] font-bold leading-none tracking-[0.005em] desk:text-[29px]">
          {SITE.title}
        </span>
        <span
          class="whitespace-nowrap text-[11.5px] uppercase tracking-[0.07em] text-muted desk:hidden min-[1360px]:block min-[1360px]:border-l-[1.5px] min-[1360px]:border-ink min-[1360px]:pl-4 min-[1360px]:text-[12.5px]"
        >
          {SITE.tagline}
        </span>
      </span>
    </a>

    <nav class="ml-auto hidden gap-6 desk:flex" aria-label="Glavna navigacija">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              "whitespace-nowrap border-b-[3px] py-1.5 no-underline",
              current === item.href ? "border-yellow font-bold" : "border-transparent",
            ]}
            aria-current={current === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/#prati" class="btn btn-dark ml-auto whitespace-nowrap px-3.5 py-2.5 desk:ml-1.5 desk:px-[22px] desk:py-3">
      <Icon name="bell" class="h-[18px] w-[18px]" />
      <span class="sr-only desk:not-sr-only">Prati projekt</span>
    </a>
  </div>
</header>
