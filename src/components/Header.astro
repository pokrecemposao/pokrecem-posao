---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { NAV, SITE } from "../config/site.ts";

interface Props {
  current: string;
}
const { current } = Astro.props;
---
<header class="sticky top-0 z-20 border-b border-line bg-cream/95 backdrop-blur">
  <div class="wrap flex h-[68px] items-center gap-4 desk:h-[76px] desk:gap-6">
    <a href="/" class="flex min-w-0 shrink-0 items-center gap-2.5 no-underline desk:gap-3" aria-label="Pokrećem posao, početna">
      <Logo class="h-11 w-auto shrink-0 text-mark desk:h-[50px]" />
      <!-- Natpis prema LOGO_text.svg: dva retka, POKREĆEM obično, POSAO podebljano, Rhodium Libre -->
      <span class="flex flex-col font-wordmark text-[19px] leading-[0.9] whitespace-nowrap text-mark desk:text-[22px]" aria-hidden="true">
        <span class="font-normal">POKREĆEM</span>
        <span class="font-bold">POSAO</span>
      </span>
      <span
        class="hidden whitespace-nowrap border-l-[1.5px] border-ink pl-4 text-[12.5px] uppercase tracking-[0.07em] text-muted min-[1360px]:block"
      >
        {SITE.tagline}
      </span>
    </a>

    <nav class="ml-auto hidden gap-6 desk:flex" aria-label="Glavna navigacija">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={[
              "whitespace-nowrap border-b-[3px] py-1.5 no-underline",
              current === item.href ? "border-yellow font-bold" : "border-transparent",
            ]}
            aria-current={current === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/#prati" class="btn btn-dark ml-auto whitespace-nowrap px-3.5 py-2.5 desk:ml-1.5 desk:px-[22px] desk:py-3">
      <Icon name="bell" class="h-[18px] w-[18px]" />
      <span class="sr-only desk:not-sr-only">Prati projekt</span>
    </a>
  </div>
</header>
