---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../config/site.ts";
import { dayNumber, formatDate, todayInZagreb } from "../lib/format.ts";

// Faza 0: samo provjera da izračun dana radi u buildu. Prave brojke dolaze u fazi 2.
const buildDate = todayInZagreb();
const day = dayNumber(buildDate, SITE.projectStartDate);
---
<BaseLayout nav="/">
  <section class="grid border-b border-line desk:grid-cols-[1fr_1.15fr]">
    <div class="flex flex-col justify-center gap-5 px-5 pt-[30px] pb-[26px] desk:py-16 desk:pr-10 desk:pl-[max(20px,calc((100vw_-_1160px)/2))]">
      <span class="eyebrow">Stvarni projekt</span>
      <h1 class="m-0 text-[clamp(42px,5.4vw,70px)] font-extrabold leading-[1.02] tracking-[-0.02em]">
        Od 12 m² do vlastitog posla.
      </h1>
      <p class="m-0 max-w-[30em] text-[17.5px] text-body desk:text-[19px]">
        Prati cijeli proces pokretanja posla uzgoja mikrozelenja: prostor, papirologiju, troškove, rad, izazove i prve kupce. Bez uljepšavanja.
      </p>
      <div class="mt-1.5 flex flex-col gap-2.5 desk:flex-row desk:gap-3">
        <a class="btn btn-yellow justify-center whitespace-nowrap" href="#prati">Počni pratiti projekt</a>
        <a class="btn btn-outline justify-center whitespace-nowrap" href="/epizode/">
          Sve epizode <Icon name="arrow" class="h-[18px] w-[18px]" />
        </a>
      </div>
    </div>
    <div
      class="relative grid min-h-[230px] place-items-center bg-[repeating-linear-gradient(135deg,#2a2620_0_14px,#24211b_14px_28px)] text-center text-sm text-[#cfc7b7] desk:min-h-[440px] desk:[clip-path:polygon(14%_0,100%_0,100%_100%,0_100%)]"
      role="img"
      aria-label="Mjesto za fotografiju prostora"
    >
      <span class="flex flex-col items-center gap-2 px-6">
        <Icon name="camera" class="h-7 w-7 opacity-70" />
        Ovdje dolazi fotografija prostora
      </span>
    </div>
  </section>

  <div class="wrap pt-11">
    <div class="card flex items-start gap-3 bg-yellow-soft">
      <Icon name="info" class="mt-0.5 h-5 w-5 shrink-0" />
      <p class="m-0">
        Stranica je u izradi. Ovdje će biti najnovije epizode, brojke i faze projekta.
        <span class="num">Danas je Dan {day} projekta ({formatDate(buildDate)}).</span>
      </p>
    </div>
  </div>
</BaseLayout>
